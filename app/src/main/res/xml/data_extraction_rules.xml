<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="jetpref_datastore/speakkeys-voice-preferences.jetpref" />
        <exclude
            domain="device_root"
            path="jetpref_datastore/speakkeys-voice-preferences.jetpref" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="root"
            path="jetpref_datastore/speakkeys-voice-preferences.jetpref" />
        <exclude
            domain="device_root"
            path="jetpref_datastore/speakkeys-voice-preferences.jetpref" />
    </device-transfer>
</data-extraction-rules>
